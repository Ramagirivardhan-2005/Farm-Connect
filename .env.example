# -------------------------------------------------------------
# FarmConnect — Environment Configuration Template (.env.example)
# Never commit production credentials to source repositories
# -------------------------------------------------------------

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/farmconnect
REDIS_URL=redis://localhost:6379

# Cryptography & Security (AES-256-GCM 32-byte hex key)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_SECRET=super_secure_access_token_secret_min_32_chars_long_1234
JWT_REFRESH_SECRET=super_secure_refresh_token_secret_min_32_chars_long_5678

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Nodemailer / SMTP Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@farmconnect.org
SMTP_PASSWORD=your_smtp_app_password_here
EMAIL_FROM="FarmConnect Marketplace" <noreply@farmconnect.org>

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=farmconnect
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Google Gemini AI Assistance API
GEMINI_API_KEY=your_gemini_api_key_here
